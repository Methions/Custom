local function sqName(s)
    return string.char(97 + band(s, 15)) .. tostring(rshift(s, 4) + 1)
end

local function moveEncode(from, to, promo, flags)
    return from + to * 128 + promo * 16384 + flags * 131072
end

local function moveFrom(m) return band(m, 127) end
local function moveTo(m) return band(rshift(m, 7), 127) end
local function movePromo(m) return band(rshift(m, 14), 7) end
local function moveFlags(m) return band(rshift(m, 17), 15) end

local function moveUci(m)
    local p = movePromo(m)
    local suffix = p == KNIGHT and "n" or p == BISHOP and "b" or p == ROOK and "r" or p == QUEEN and "q" or ""
    return sqName(moveFrom(m)) .. sqName(moveTo(m)) .. suffix
end

local function xorshift32()
    local x = G.Seed or 0xA57F19D1
    x = bxor(x, lshift(x, 13))
    x = bxor(x, rshift(x, 17))
    x = bxor(x, lshift(x, 5))
    G.Seed = x
    return x
end


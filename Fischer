local vMg, vEg = {}, {}
for i = 1, 14 * 128 + 128 do vMg[i] = 0; vEg[i] = 0 end
for _, sq in ipairs(sqList) do
    local rankIdx = sq // 10 - 2
    local file = sq % 10 - 2
    for t = 1, 6 do
        local iw = rankIdx * 8 + file + 1
        local ib = (7 - rankIdx) * 8 + file + 1
        vMg[t * 128 + sq] = MAT_MG[t] + PST_MG[t][iw]
        vEg[t * 128 + sq] = MAT_EG[t] + PST_EG[t][iw]
        vMg[(t + 8) * 128 + sq] = -(MAT_MG[t] + PST_MG[t][ib])
        vEg[(t + 8) * 128 + sq] = -(MAT_EG[t] + PST_EG[t][ib])
    end
end

local cdist = {}
for _, sq in ipairs(sqList) do
    local f, r = sq % 10 - 2, sq // 10 - 2
    cdist[sq] = math.max(3 - f, f - 4) + math.max(3 - r, r - 4)
end

local function attacked(sq, by)
    if by == 0 then
        if board[sq + 9] == 1 or board[sq + 11] == 1 then return true end
    else
        if board[sq - 9] == 9 or board[sq - 11] == 9 then return true end
    end
    local base = (by == 0) and 0 or 8
    local nk, kg, bi, ro, qu = base + 2, base + 6, base + 3, base + 4, base + 5
    for k = 1, 8 do
        if board[sq + KNOFF[k]] == nk then return true end
        if board[sq + KGOFF[k]] == kg then return true end
    end
    for k = 1, 4 do
        local d = BDIR[k]
        local s = sq + d
        local q = board[s]
        while q == 0 do s = s + d; q = board[s] end
        if q == bi or q == qu then return true end
        d = RDIR[k]
        s = sq + d
        q = board[s]
        while q == 0 do s = s + d; q = board[s] end
        if q == ro or q == qu then return true end
    end
    return false
end


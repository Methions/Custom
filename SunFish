function Position.new(board, score, wc, bc, ep, kp, half, fullmove)
    return setmetatable({
        board = board,
        score = score or 0,
        wc = wc or {false,false},
        bc = bc or {false,false},
        ep = ep or 0,
        kp = kp or 0,
        half = half or 0,
        fullmove = fullmove or 1,
    }, Position)
end

function Position:key()
    local k = self._key
    if k then return k end
    k = self.board .. ";" .. boolPairKey(self.wc) .. ";" .. boolPairKey(self.bc) .. ";" .. tostring(self.ep) .. ";" .. tostring(self.kp)
    self._key = k
    return k
end

function Position:check()
    local k = findKing(self.board)
    return k and attacked(self.board, k, false) or false
end

function Position:rotate()
    return Position.new(swapcaseReverse(self.board), -self.score, clonePair(self.bc), clonePair(self.wc), self.ep > 0 and 119 - self.ep or 0, self.kp > 0 and 119 - self.kp or 0, self.half, self.fullmove)
end

function Position:nullMove()
    return Position.new(swapcaseReverse(self.board), -self.score, clonePair(self.bc), clonePair(self.wc), 0, 0, self.half + 1, self.fullmove)
end

function Position:value(m)
    local i, j, promo = m[1], m[2], m[3]
    local p, q = cell(self.board, i), cell(self.board, j)
    local base = pst[p] and (pst[p][j + 1] - pst[p][i + 1]) or 0
    if q ~= "." and q ~= " " and q ~= "\n" then
        base = base + (pst[upperMap[q]] and pst[upperMap[q]][j + 1] or 0)
    end
    if promo then
        local pn = PIECE_CH[promo] or "Q"
        base = base + (pst[pn][j + 1] or VALUE[pn]) - (pst["P"][j + 1] or VALUE.P)
    end
    if p == "P" and j == self.ep and q == "." then
        base = base + (pst.P[j + S + 1] or 0)
    end
    if p == "K" and abs(i - j) == 2 then
        local rookFrom = j < i and A1 or H1
        local rookTo = floor((i + j) / 2)
        base = base + pst.R[rookTo + 1] - pst.R[rookFrom + 1]
    end
    return base
end

function Position:apply(m)
    local i, j, promo = m[1], m[2], m[3]
    local p, q = cell(self.board, i), cell(self.board, j)
    if p ~= "P" and p ~= "N" and p ~= "B" and p ~= "R" and p ~= "Q" and p ~= "K" then return nil end
    if q == "k" then return nil end
    local board = self.board
    local wc, bc = clonePair(self.wc), clonePair(self.bc)
    local ep, kp = 0, 0
    local score = self.score + self:value(m)

    if i == A1 then wc[1] = false elseif i == H1 then wc[2] = false end
    if j == A8 then bc[1] = false elseif j == H8 then bc[2] = false end
    if p == "K" then wc[1], wc[2] = false, false end

    board = put(board, i, ".")

    if p == "P" and j == self.ep and q == "." then
        local capSq = j + S
        if cell(board, capSq) ~= "p" then return nil end
        board = put(board, capSq, ".")
    end

    local placed = p
    if p == "P" and j >= A8 and j <= H8 then
        placed = PIECE_CH[promo or 5] or "Q"
        if promo == nil then promo = 5 end
    end
    board = put(board, j, placed)

    if p == "K" and abs(i - j) == 2 then
        if j > i then
            board = put(board, H1, ".")
            board = put(board, H1 - 2, "R")
            kp = i + E
        else
            board = put(board, A1, ".")
            board = put(board, A1 + 3, "R")
            kp = i + W
        end
    end

    if p == "P" and j - i == 2 * N then
        ep = i + N
    end

    local king = findKing(board)
    if not king or attacked(board, king, false) then return nil end

    local halfNext = (p == "P" or (q ~= "." and q ~= " " and q ~= "\n")) and 0 or (self.half + 1)
    local next = Position.new(swapcaseReverse(board), -score, bc, wc, ep > 0 and 119 - ep or 0, kp > 0 and 119 - kp or 0, halfNext, self.fullmove)
    return next
end


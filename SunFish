local dir = {
    P = {N, 2*N, N+W, N+E},
    N = {2*N+E, N+2*E, S+2*E, 2*S+E, 2*S+W, S+2*W, N+2*W, 2*N+W},
    B = {N+E, S+E, S+W, N+W},
    R = {N, E, S, W},
    Q = {N, E, S, W, N+E, S+E, S+W, N+W},
    K = {N, E, S, W, N+E, S+E, S+W, N+W}
}

local VALUE = {P = 198, N = 850, B = 840, R = 1268, Q = 2529, K = 60000}
local PROMO = {Q = 5, R = 4, B = 3, N = 2}
local PROMO_CH = { [5] = "q", [4] = "r", [3] = "b", [2] = "n" }
local PIECE_CH = { [1] = "P", [2] = "N", [3] = "B", [4] = "R", [5] = "Q", [6] = "K" }
local lowerMap = {P="p",N="n",B="b",R="r",Q="q",K="k"}
local upperMap = {p="P",n="N",b="B",r="R",q="Q",k="K"}

local function isValid(i)
    if i < 0 or i >= 120 then return false end
    local x = i % 10
    return i >= 20 and i <= 99 and x >= 1 and x <= 8
end

local function cell(board, i)
    if i < 0 or i >= #board then return " " end
    return board:sub(i + 1, i + 1)
end

local function put(board, i, p)
    return board:sub(1, i) .. p .. board:sub(i + 2)
end

local function swapcaseReverse(board)
    local out = {}
    local n = #board
    for i = n, 1, -1 do
        local c = board:sub(i, i)
        if upperMap[c] then c = upperMap[c]
        elseif lowerMap[c] then c = lowerMap[c] end
        out[#out + 1] = c
    end
    return table.concat(out)
end

local function boolPairKey(p)
    return (p[1] and "1" or "0") .. (p[2] and "1" or "0")
end

local function moveKey(m)
    return tostring(m[1]) .. ":" .. tostring(m[2]) .. ":" .. tostring(m[3] or 0)
end

local function moveUci(m, flipped)
    local a, b, promo = m[1], m[2], m[3]
    if flipped then a, b = 119 - a, 119 - b end
    local af = (a % 10) - 1
    local ar = 10 - floor(a / 10)
    local bf = (b % 10) - 1
    local br = 10 - floor(b / 10)
    local s = string.char(97 + af) .. tostring(ar) .. string.char(97 + bf) .. tostring(br)
    if promo then s = s .. (PROMO_CH[promo] or "q") end
    return s
end

local function parseSquare(s)
    if type(s) ~= "string" or #s < 2 then return nil end
    local f = string.byte(s, 1) - 97
    local r = tonumber(s:sub(2, 2))
    if f < 0 or f > 7 or not r or r < 1 or r > 8 then return nil end
    return A1 + f + (1 - r) * 10
end

local function parseMoveUci(s)
    if type(s) ~= "string" or #s < 4 then return nil end
    local a, b = parseSquare(s:sub(1,2)), parseSquare(s:sub(3,4))
    if not a or not b then return nil end
    local p = 5
    local pc = s:sub(5,5):lower()
    if pc == "q" then p = 5 elseif pc == "r" then p = 4 elseif pc == "b" then p = 3 elseif pc == "n" then p = 2 else p = 0 end
    return {a, b, p ~= 0 and p or nil}
end

local function clonePair(p)
    return {p[1], p[2]}
end

local function attacked(board, sq, upper)
    local pawn = upper and "P" or "p"
    local knight = upper and "N" or "n"
    local bishop = upper and "B" or "b"
    local rook = upper and "R" or "r"
    local queen = upper and "Q" or "q"
    local king = upper and "K" or "k"

    if upper then
        if cell(board, sq + 9) == pawn or cell(board, sq + 11) == pawn then return true end
    else
        if cell(board, sq - 9) == pawn or cell(board, sq - 11) == pawn then return true end
    end

    local nd = dir.N
    for i = 1, 8 do
        if cell(board, sq + nd[i]) == knight then return true end
    end

    for i = 1, 4 do
        local d = dir.B[i]
        local t = sq + d
        while isValid(t) do
            local p = cell(board, t)
            if p ~= "." then
                if p == bishop or p == queen then return true end
                break
            end
            t = t + d
        end
    end

    for i = 1, 4 do
        local d = dir.R[i]
        local t = sq + d
        while isValid(t) do
            local p = cell(board, t)
            if p ~= "." then
                if p == rook or p == queen then return true end
                break
            end
            t = t + d
        end
    end

    for i = 1, 8 do
        if cell(board, sq + dir.K[i]) == king then return true end
    end
    return false
end

local function findKing(board)
    local i = board:find("K")
    if not i then return nil end
    return i - 1
end

